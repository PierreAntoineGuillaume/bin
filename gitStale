#!/usr/bin/env bash

set -euo pipefail

months=6
prefix=

usage() {
    echo "usage: $0 [--months N] branch-prefix" >&2
    echo "Default months = $months" >&2
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -m|--months) months="$2"; shift 2 ;;
        -h|--help) usage ;;
        *) prefix="$1"; shift ;;
    esac
done

if [ -z "$prefix" ]; then
  >&2 echo "no branch prefix provided"
  usage
fi

git fetch --quiet --prune origin

cutoff=$(date -d "-${months} months" +%s)

git for-each-ref --format='%(committerdate:unix) %(refname:lstrip=3)' "refs/remotes/origin/$prefix" \
    | awk -v cutoff="$cutoff" '$1 < cutoff { print $2 }'
